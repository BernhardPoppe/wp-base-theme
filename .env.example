# SFTP Deploy
# Datei nach `.env` kopieren und ausfüllen. Wird von `npm run deploy` gelesen.

SFTP_HOST=example.com
SFTP_PORT=22
SFTP_USER=username

# Authentifizierung: entweder Passwort ODER Private Key (mit optionaler Passphrase)
SFTP_PASSWORD=
# SFTP_PRIVATE_KEY=~/.ssh/id_ed25519
# SFTP_PASSPHRASE=

# Absoluter Pfad zum Theme-Ordner auf dem Server
SFTP_REMOTE_PATH=/var/www/html/wp-content/themes/my-theme
